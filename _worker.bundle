      return false;
    }
    await db.prepare(`
      INSERT INTO community_auth_attempts (ip_hash, attempt_type) 
      VALUES (?, ?);
    `).bind(ipHash, attemptType).run();
    return true;
  } catch (err) {
    console.error("Rate limiting error:", err);
    return true;
  }
}
